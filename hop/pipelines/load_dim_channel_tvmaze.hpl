  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT
    'TVMAZE' AS SOURCE,
    CAST(NULL AS VARCHAR2(100)) AS SOURCE_CHANNEL_ID,
    NVL(NETWORK, WEB_CHANNEL) AS CHANNEL_NAME,
    CAST(NULL AS VARCHAR2(200)) AS SLUG,
    CAST(NULL AS VARCHAR2(1000)) AS LOGO_URL,
    COUNTRY_CODE,
    MAX(LOAD_DATE) AS LOAD_DATE
FROM STG_TVMAZE_SCHEDULE
WHERE NVL(NETWORK, WEB_CHANNEL) IS NOT NULL
GROUP BY NVL(NETWORK, WEB_CHANNEL), COUNTRY_CODE</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
