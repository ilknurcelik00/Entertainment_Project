  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT
    DC.CONTENT_KEY,
    CH.CHANNEL_KEY,
    DD.DATE_KEY,
    'TVMAZE' AS SOURCE,
    S.EPISODE_ID AS SOURCE_EPISODE_ID,
    S.EPISODE_NAME,
    S.SEASON AS SEASON_NUMBER,
    S.EPISODE_NUMBER,
    S.AIRTIME,
    S.RUNTIME,
    S.LOAD_DATE
FROM STG_TVMAZE_SCHEDULE S

LEFT JOIN (
    SELECT
        UPPER(TRIM(TITLE)) AS NORMALIZED_TITLE,
        MIN(CONTENT_KEY) AS CONTENT_KEY
    FROM DIM_CONTENT
    WHERE CONTENT_TYPE = 'TV'
    GROUP BY UPPER(TRIM(TITLE))
) DC
    ON DC.NORMALIZED_TITLE = UPPER(TRIM(S.SHOW_NAME))

LEFT JOIN DIM_CHANNEL CH
    ON CH.SOURCE = 'TVMAZE'
   AND UPPER(TRIM(CH.CHANNEL_NAME)) =
       UPPER(TRIM(S.NETWORK))

INNER JOIN DIM_DATE DD
    ON DD.FULL_DATE = TRUNC(S.AIRDATE)</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>DIGITURK_ORACLE</connection>
    <lookup/>
