<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type><pipeline_status>-1</pipeline_status><parameters/>
    <name>load_fact_user_rating</name><name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user><modified_user>-</modified_user>
  </info>
  <transform>
    <type>TableInput</type><name>Join ratings to dimensions</name>
    <sql>SELECT
    S.RATING_ID AS SOURCE_RATING_ID,
    C.CONTENT_KEY,
    D.DATE_KEY,
    S.USER_ID,
    S.COUNTRY_CODE,
    S.RATING,
    S.RATED_AT,
    S.IS_SYNTHETIC,
    S.LOAD_DATE
FROM STG_USER_RATING S
JOIN DIM_CONTENT C
  ON C.SOURCE = S.SOURCE
 AND C.SOURCE_CONTENT_ID = S.SOURCE_CONTENT_ID
 AND C.CONTENT_TYPE = S.CONTENT_TYPE
JOIN DIM_DATE D
  ON D.FULL_DATE = TRUNC(S.RATED_AT)</sql>
    <limit>0</limit><execute_each_row>N</execute_each_row><variables_active>N</variables_active>
    <connection>DIGITURK_ORACLE</connection><lookup/><sql_from_file/>
    <distribute>Y</distribute><copies>1</copies>
    <GUI><xloc>176</xloc><yloc>192</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type><name>Insert / update</name>
    <lookup>
      <key><name>SOURCE_RATING_ID</name><field>SOURCE_RATING_ID</field><condition>=</condition><name2/></key>
      <value><name>SOURCE_RATING_ID</name><rename>SOURCE_RATING_ID</rename><update>N</update></value>
      <value><name>CONTENT_KEY</name><rename>CONTENT_KEY</rename><update>Y</update></value>
      <value><name>DATE_KEY</name><rename>DATE_KEY</rename><update>Y</update></value>
      <value><name>USER_ID</name><rename>USER_ID</rename><update>Y</update></value>
      <value><name>COUNTRY_CODE</name><rename>COUNTRY_CODE</rename><update>Y</update></value>
      <value><name>RATING</name><rename>RATING</rename><update>Y</update></value>
      <value><name>RATED_AT</name><rename>RATED_AT</rename><update>Y</update></value>
      <value><name>IS_SYNTHETIC</name><rename>IS_SYNTHETIC</rename><update>Y</update></value>
      <value><name>LOAD_DATE</name><rename>LOAD_DATE</rename><update>Y</update></value>
      <schema>STAJYER</schema><table>FACT_USER_RATING</table>
    </lookup>
    <commit>500</commit><update_bypassed>N</update_bypassed><connection>DIGITURK_ORACLE</connection>
    <distribute>Y</distribute><copies>1</copies>
    <GUI><xloc>384</xloc><yloc>192</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning><attributes/>
  </transform>
  <order><hop><from>Join ratings to dimensions</from><to>Insert / update</to><enabled>Y</enabled></hop></order>
  <notepads/><attributes/><transform_error_handling/>
</pipeline>
