  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT
    DC.CONTENT_KEY,
    DD.DATE_KEY,
    S.POPULARITY,
    S.VOTE_AVERAGE,
    S.VOTE_COUNT,
    S.LOAD_DATE
FROM (
    SELECT
        'TMDB' AS SOURCE,
        'MOVIE' AS CONTENT_TYPE,
        TO_CHAR(TMDB_ID) AS SOURCE_CONTENT_ID,
        POPULARITY,
        VOTE_AVERAGE,
        VOTE_COUNT,
        LOAD_DATE
    FROM STG_TMDB_MOVIE

    UNION ALL

    SELECT
        'TMDB' AS SOURCE,
        'TV' AS CONTENT_TYPE,
        TO_CHAR(TMDB_ID) AS SOURCE_CONTENT_ID,
        POPULARITY,
        VOTE_AVERAGE,
        VOTE_COUNT,
        LOAD_DATE
    FROM STG_TMDB_TV
) S
INNER JOIN DIM_CONTENT DC
    ON DC.SOURCE = S.SOURCE
   AND DC.CONTENT_TYPE = S.CONTENT_TYPE
   AND DC.SOURCE_CONTENT_ID = S.SOURCE_CONTENT_ID
INNER JOIN DIM_DATE DD
    ON DD.FULL_DATE = TRUNC(S.LOAD_DATE)</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>DIGITURK_ORACLE</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
