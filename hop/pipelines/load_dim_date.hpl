  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>WITH SOURCE_DATES AS (
    SELECT TRUNC(LOAD_DATE) AS FULL_DATE
    FROM STG_TMDB_MOVIE

    UNION

    SELECT TRUNC(LOAD_DATE)
    FROM STG_TMDB_TV

    UNION

    SELECT TRUNC(LOAD_DATE)
    FROM STG_TVMAZE_SCHEDULE

    UNION

    SELECT TRUNC(AIRDATE)
    FROM STG_TVMAZE_SCHEDULE
)
SELECT
    TO_NUMBER(TO_CHAR(FULL_DATE, 'YYYYMMDD')) AS DATE_KEY,
    FULL_DATE,
    TO_NUMBER(TO_CHAR(FULL_DATE, 'DD')) AS DAY_NUMBER,
    TRIM(
        TO_CHAR(
            FULL_DATE,
            'Day',
            'NLS_DATE_LANGUAGE=TURKISH'
        )
    ) AS DAY_NAME,
       TO_NUMBER(TO_CHAR(FULL_DATE, 'MM')) AS MONTH_NUMBER,
    TRIM(
        TO_CHAR(
            FULL_DATE,
            'Month',
            'NLS_DATE_LANGUAGE=TURKISH'
        )
    ) AS MONTH_NAME,
    TO_NUMBER(TO_CHAR(FULL_DATE, 'Q')) AS QUARTER_NUMBER,
    TO_NUMBER(TO_CHAR(FULL_DATE, 'YYYY')) AS YEAR_NUMBER,
    CASE
        WHEN TO_CHAR(
            FULL_DATE,
            'DY',
            'NLS_DATE_LANGUAGE=ENGLISH'
        ) IN ('SAT', 'SUN')
        THEN 1
        ELSE 0
    END AS IS_WEEKEND
FROM SOURCE_DATES
WHERE FULL_DATE IS NOT NULL
ORDER BY FULL_DATE</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>DIGITURK_ORACLE</connection>
