    <created_date>2026/09/08 14:57:08.415</created_date>
    <modified_date>2026/09/08 14:57:08.415</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT DISTINCT
    dc.CONTENT_KEY,
    dg.GENRE_KEY
FROM (
    SELECT
        'MOVIE' AS CONTENT_TYPE,
        m.TMDB_ID AS SOURCE_CONTENT_ID,
        jt.GENRE_ID
    FROM STG_TMDB_MOVIE m
    CROSS APPLY JSON_TABLE(
        m.GENRE_IDS,
        '$[*]'
        COLUMNS (
            GENRE_ID NUMBER PATH '$'
        )
    ) jt

    UNION ALL

    SELECT
        'TV' AS CONTENT_TYPE,
        t.TMDB_ID AS SOURCE_CONTENT_ID,
        jt.GENRE_ID
    FROM STG_TMDB_TV t
    CROSS APPLY JSON_TABLE(
        t.GENRE_IDS,
        '$[*]'
        COLUMNS (
            GENRE_ID NUMBER PATH '$'
        )
    ) jt
) x
JOIN DIM_CONTENT dc
    ON dc.SOURCE = 'TMDB'
   AND dc.CONTENT_TYPE = x.CONTENT_TYPE
   AND dc.SOURCE_CONTENT_ID = x.SOURCE_CONTENT_ID
JOIN DIM_GENRE dg
    ON dg.SOURCE = 'TMDB'
   AND dg.SOURCE_GENRE_ID = x.GENRE_ID</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>DIGITURK_ORACLE</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Insert / update</name>
    <lookup>
      <key>
        <name>CONTENT_KEY</name>
        <field>CONTENT_KEY</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>GENRE_KEY</name>
        <field>GENRE_KEY</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>CONTENT_KEY</name>
        <rename>CONTENT_KEY</rename>
        <update>N</update>
      </value>
      <value>
        <name>GENRE_KEY</name>
        <rename>GENRE_KEY</rename>
        <update>N</update>
      </value>
      <schema>STAJYER</schema>
      <table>BRIDGE_CONTENT_GENRE</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <connection>DIGITURK_ORACLE</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>304</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
